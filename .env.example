# Local Docker: postgresql://farmos:farmos@localhost:5432/farmos
# Hosted (Vercel/Neon): use the pooled URL with sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/farmos?sslmode=require"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Set true only behind a trusted reverse proxy.
AUTH_TRUST_HOST=
MAPBOX_TOKEN=
# Unused. Weather page calls Open-Meteo with farm-boundary coordinates.
WEATHER_API_KEY=
