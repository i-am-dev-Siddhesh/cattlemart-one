# Local default is SQLite so the app runs without Docker.
# For PostgreSQL: postgresql://USER:PASSWORD@localhost:5432/farmos
DATABASE_URL="file:./dev.db"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Set true only behind a trusted reverse proxy.
AUTH_TRUST_HOST=
MAPBOX_TOKEN=
# Unused. Weather page calls Open-Meteo with farm-boundary coordinates.
WEATHER_API_KEY=
